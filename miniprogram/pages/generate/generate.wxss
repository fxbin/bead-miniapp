.generate-page { padding-bottom: 72rpx; }

.hidden-canvas { position: fixed; left: -9999px; width: 1px; height: 1px; }

.page-head { padding: 26rpx 6rpx 30rpx; }
.eyebrow { font-size: 20rpx; letter-spacing: 5rpx; color: #b39b89; margin-bottom: 12rpx; }
.page-title { font-size: 54rpx; font-weight: 700; color: #282522; }
.page-subtitle { margin-top: 12rpx; font-size: 27rpx; color: #8c8077; }

.photo-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  background: #ece7e0;
  box-shadow: 0 16rpx 40rpx rgba(89, 70, 53, 0.09);
  margin-bottom: 24rpx;
}
.preview-image { display: block; width: 100%; height: 430rpx; }
.re-select {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.9);
  color: #685c54;
  font-size: 24rpx;
  backdrop-filter: blur(10px);
}

.empty-card { text-align: center; padding: 70rpx 32rpx; }
.empty-beads { display: flex; justify-content: center; gap: 12rpx; margin-bottom: 30rpx; }
.empty-bead, .loader-bead {
  width: 44rpx; height: 44rpx; border-radius: 50%; position: relative;
  box-shadow: inset 0 0 0 7rpx rgba(255,255,255,.28), 0 6rpx 12rpx rgba(65,47,37,.1);
}
.empty-bead::after, .loader-bead::after {
  content: ''; position: absolute; left: 50%; top: 50%; width: 32%; height: 32%;
  transform: translate(-50%,-50%); border-radius: 50%; background: #f7f5f0;
}
.eb1, .lb1 { background: #ef9dae; }
.eb2, .lb2 { background: #8ecbd2; }
.eb3, .lb3 { background: #f0c75e; }
.lb4 { background: #7aa58b; }
.empty-title { font-size: 34rpx; font-weight: 600; color: #332f2b; }
.empty-hint { margin-top: 12rpx; font-size: 25rpx; color: #998d84; }
.outline-action {
  display: inline-block; margin-top: 30rpx; padding: 18rpx 42rpx; border: 2rpx solid #d88a73;
  border-radius: 999rpx; color: #c96f56; font-size: 28rpx;
}

.setting-card {
  background: rgba(255,255,255,.88);
  border: 1rpx solid rgba(126,105,88,.08);
  border-radius: 30rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 36rpx rgba(89,70,53,.06);
}
.setting-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 26rpx; }
.setting-title { font-size: 31rpx; font-weight: 650; color: #302c29; }
.setting-hint { margin-top: 6rpx; font-size: 23rpx; color: #9b8e84; }

.size-options { display: flex; gap: 14rpx; }
.size-chip {
  position: relative; flex: 1; padding: 22rpx 6rpx; text-align: center; border-radius: 999rpx;
  border: 2rpx solid #e6ddd5; background: #fbfaf8; color: #665a52; font-size: 27rpx;
}
.size-chip.selected { border-color: #ee8468; color: #b95f49; background: #fff8f5; box-shadow: 0 6rpx 16rpx rgba(224,112,83,.09); }
.recommend-badge {
  position: absolute; right: -4rpx; top: -22rpx; padding: 5rpx 12rpx; border-radius: 999rpx;
  background: #ee8468; color: white; font-size: 18rpx;
}

.preset-options { display: flex; gap: 14rpx; }
.preset-card {
  position: relative; flex: 1; min-height: 210rpx; padding: 22rpx 10rpx; box-sizing: border-box;
  border-radius: 24rpx; border: 2rpx solid #ebe3dc; background: #fcfbf9; text-align: center;
}
.preset-card.selected { border-color: #ee8468; background: #fff8f5; box-shadow: 0 8rpx 18rpx rgba(224,112,83,.08); }
.preset-symbol { font-size: 34rpx; color: #b6a395; margin-bottom: 10rpx; }
.preset-card.selected .preset-symbol { color: #dd755b; }
.preset-name { font-size: 29rpx; font-weight: 600; color: #342f2b; }
.preset-desc { margin-top: 10rpx; font-size: 22rpx; line-height: 1.5; color: #988b81; }
.selected-dot {
  position: absolute; right: -2rpx; top: -2rpx; width: 36rpx; height: 36rpx; line-height: 36rpx;
  border-radius: 0 20rpx 0 18rpx; background: #ee8468; color: #fff; font-size: 20rpx;
}

.privacy-note { text-align: center; color: #9b8f85; font-size: 23rpx; margin: 28rpx 0 20rpx; }
.error-card { padding: 20rpx 24rpx; border-radius: 20rpx; background: #fff0ec; margin-bottom: 18rpx; }
.error-text { color: #ba5d4d; font-size: 25rpx; }
.generate-button { margin-top: 8rpx; }

.generation-overlay {
  position: fixed; inset: 0; z-index: 100; background: rgba(247,245,240,.9);
  display: flex; align-items: center; justify-content: center; padding: 50rpx;
}
.generation-panel { width: 100%; padding: 70rpx 36rpx; border-radius: 38rpx; background: rgba(255,255,255,.94); text-align: center; box-shadow: 0 24rpx 70rpx rgba(75,59,47,.12); }
.loader-row { display: flex; justify-content: center; gap: 12rpx; margin-bottom: 30rpx; }
.loader-bead { animation: beadPulse 1s ease-in-out infinite alternate; }
.lb2 { animation-delay: .12s; }
.lb3 { animation-delay: .24s; }
.lb4 { animation-delay: .36s; }
.generation-title { font-size: 34rpx; font-weight: 650; color: #302b28; }
.generation-copy { margin-top: 12rpx; font-size: 24rpx; color: #998b81; }

@keyframes beadPulse {
  from { transform: translateY(0) scale(.92); opacity: .72; }
  to { transform: translateY(-10rpx) scale(1); opacity: 1; }
}
