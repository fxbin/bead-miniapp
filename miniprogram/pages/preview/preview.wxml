<view class="container">
  <view class="card" wx:if="{{patternResult}}">
    <view class="info-row">
      <text class="info-label">尺寸</text>
      <text class="info-value">{{patternResult.width}} × {{patternResult.height}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">总豆数</text>
      <text class="info-value">{{patternResult.totalBeads}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">颜色数</text>
      <text class="info-value">{{patternResult.uniqueColors}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{patternResult}}">
    <view class="controls">
      <view class="control-btn {{showGrid ? 'active' : ''}}" bindtap="onToggleGrid">网格</view>
      <view class="control-btn {{showCodes ? 'active' : ''}}" bindtap="onToggleCodes">色号</view>
      <view class="control-btn {{editMode ? 'active' : ''}}" bindtap="onToggleEdit">编辑</view>
      <view class="control-btn {{canUndo ? '' : 'disabled'}}" bindtap="onUndo">撤销</view>
    </view>
  </view>

  <view class="canvas-container" wx:if="{{patternResult}}">
    <scroll-view scroll-x scroll-y class="canvas-scroll">
      <canvas
        type="2d"
        id="grid-canvas"
        class="grid-canvas"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        bindtap="onCanvasTap"
      ></canvas>
    </scroll-view>
  </view>

  <!-- #22: Color picker overlay -->
  <view class="color-picker-mask" wx:if="{{showColorPicker}}" bindtap="onCloseColorPicker">
    <view class="color-picker" catchtap="">
      <view class="picker-header">
        <text>当前: {{selectedCell.code}}</text>
        <text class="picker-close" bindtap="onCloseColorPicker">关闭</text>
      </view>
      <scroll-view scroll-y class="color-list">
        <view
          class="color-item"
          wx:for="{{availableColors}}"
          wx:key="code"
          data-code="{{item.code}}"
          bindtap="onColorSelect"
        >
          <view class="color-swatch" style="background: rgb({{item.rgb.r}}, {{item.rgb.g}}, {{item.rgb.b}})"></view>
          <text class="color-code">{{item.code}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="card" wx:if="{{!patternResult}}">
    <text>暂无图纸数据，请先从首页生成。</text>
  </view>

  <navigator url="/pages/export/export" class="btn-primary" wx:if="{{patternResult}}">
    查看色号清单
  </navigator>
</view>
