.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.info-label {
  font-size: 30rpx;
  color: #888;
}

.info-value {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.controls {
  display: flex;
  gap: 16rpx;
}

.control-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  font-size: 26rpx;
  color: #666;
}

.control-btn.active {
  background: #07c160;
  color: #fff;
}

.control-btn.disabled {
  opacity: 0.4;
}

.canvas-container {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.canvas-scroll {
  width: 100%;
  height: 600rpx;
}

.grid-canvas {
  width: 100%;
  height: 100%;
}

.color-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.color-picker {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 16rpx;
  font-size: 30rpx;
}

.picker-close {
  color: #07c160;
}

.color-list {
  max-height: 50vh;
}

.color-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.color-swatch {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  border: 1rpx solid #ddd;
}

.color-code {
  font-size: 28rpx;
  color: #333;
}

.btn-primary {
  display: block;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 34rpx;
  text-align: center;
  text-decoration: none;
}
