.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.info-label {
  font-size: 30rpx;
  color: #888;
}

.info-value {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.controls {
  display: flex;
  gap: 20rpx;
}

.control-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  font-size: 28rpx;
  color: #666;
}

.control-btn.active {
  background: #07c160;
  color: #fff;
}

.canvas-container {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.canvas-scroll {
  width: 100%;
  height: 600rpx;
}

.grid-canvas {
  width: 100%;
  height: 100%;
}

.btn-primary {
  display: block;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 34rpx;
  text-align: center;
  text-decoration: none;
}
