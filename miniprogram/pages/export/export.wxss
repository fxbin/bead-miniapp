.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.info-row {
  font-size: 32rpx;
  padding: 8rpx 0;
}

.usage-header {
  font-size: 34rpx;
  font-weight: bold;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 16rpx;
}

.usage-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.usage-code {
  font-size: 30rpx;
  color: #333;
}

.usage-count {
  font-size: 30rpx;
  color: #07c160;
}
