.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  width: 1px;
  height: 1px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.info-label {
  font-size: 30rpx;
  color: #888;
}

.info-value {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.sort-controls {
  display: flex;
  gap: 16rpx;
}

.sort-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  font-size: 26rpx;
  color: #666;
}

.sort-btn.active {
  background: #07c160;
  color: #fff;
}

.usage-header {
  font-size: 34rpx;
  font-weight: bold;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 16rpx;
}

.usage-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.usage-swatch {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  border: 1rpx solid #ddd;
  flex-shrink: 0;
}

.usage-code {
  font-size: 28rpx;
  color: #333;
  width: 80rpx;
  flex-shrink: 0;
}

.usage-name {
  font-size: 26rpx;
  color: #999;
  flex: 1;
}

.usage-count {
  font-size: 28rpx;
  color: #07c160;
  font-weight: bold;
  flex-shrink: 0;
}

.export-btn {
  margin-bottom: 16rpx;
}

.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn-secondary {
  text-align: center;
  padding: 20rpx;
  font-size: 30rpx;
  color: #ee0a24;
  background: #fff0f0;
  border-radius: 12rpx;
}
