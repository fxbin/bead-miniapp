/** Global styles for Bead Mini Program */
page {
  background: #f7f5f0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #22211f;
}

.container {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(126, 105, 88, 0.08);
  border-radius: 30rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 40rpx rgba(89, 70, 53, 0.07);
}

.btn-primary {
  display: block;
  background: linear-gradient(135deg, #f18b6f 0%, #ec765c 100%);
  color: #fff;
  border-radius: 999rpx;
  padding: 25rpx 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  text-decoration: none;
  box-shadow: 0 14rpx 30rpx rgba(218, 105, 78, 0.22);
}

.btn-primary.disabled,
.btn-primary[disabled] {
  opacity: 0.5;
}

.muted {
  color: #91867e;
}
